config_version=5
[application]
config/name="Galactic Dominion"
config/version="0.19.0"
run/flush_stdout_on_print=true
run/main_scene="res://scenes/main.tscn"
config/features=PackedStringArray("4.3", "GL Compatibility")
[display]
window/size/viewport_width=1280
window/size/viewport_height=720
window/stretch/mode="canvas_items"
[rendering]
antialiasing/quality/msaa_3d=2
renderer/rendering_method="gl_compatibility"
renderer/rendering_method.mobile="gl_compatibility"
environment/defaults/default_clear_color=Color(0.008, 0.012, 0.035, 1)
[physics]
common/physics_ticks_per_second=60

[input]
forward={
"deadzone": 0.2,
"events": [Object(InputEventKey,"physical_keycode":87)]
}
reverse={
"deadzone": 0.2,
"events": [Object(InputEventKey,"physical_keycode":83)]
}
strafe_left={
"deadzone": 0.2,
"events": [Object(InputEventKey,"physical_keycode":65)]
}
strafe_right={
"deadzone": 0.2,
"events": [Object(InputEventKey,"physical_keycode":68)]
}
up={
"deadzone": 0.2,
"events": [Object(InputEventKey,"physical_keycode":32)]
}
down={
"deadzone": 0.2,
"events": [Object(InputEventKey,"physical_keycode":4194326)]
}
boost={
"deadzone": 0.2,
"events": [Object(InputEventKey,"physical_keycode":4194325)]
}
roll_left={
"deadzone": 0.2,
"events": [Object(InputEventKey,"physical_keycode":81)]
}
roll_right={
"deadzone": 0.2,
"events": [Object(InputEventKey,"physical_keycode":69)]
}
target={
"deadzone": 0.2,
"events": [Object(InputEventKey,"physical_keycode":4194306)]
}
ability={
"deadzone": 0.2,
"events": [Object(InputEventKey,"physical_keycode":82)]
}
pause={
"deadzone": 0.2,
"events": [Object(InputEventKey,"physical_keycode":4194305)]
}
ship_1={
"deadzone": 0.2,
"events": [Object(InputEventKey,"physical_keycode":4194332)]
}
ship_2={
"deadzone": 0.2,
"events": [Object(InputEventKey,"physical_keycode":4194333)]
}
ship_3={
"deadzone": 0.2,
"events": [Object(InputEventKey,"physical_keycode":4194334)]
}
command_1={
"deadzone": 0.2,
"events": [Object(InputEventKey,"physical_keycode":49)]
}
command_2={
"deadzone": 0.2,
"events": [Object(InputEventKey,"physical_keycode":50)]
}
command_3={
"deadzone": 0.2,
"events": [Object(InputEventKey,"physical_keycode":51)]
}
command_4={
"deadzone": 0.2,
"events": [Object(InputEventKey,"physical_keycode":52)]
}
command_5={
"deadzone": 0.2,
"events": [Object(InputEventKey,"physical_keycode":53)]
}
laser={
"deadzone": 0.2,
"events": [Object(InputEventMouseButton,"button_index":1)]
}
missile={
"deadzone": 0.2,
"events": [Object(InputEventMouseButton,"button_index":2)]
}

scan={"deadzone": 0.2, "events": [Object(InputEventKey,"physical_keycode":71)]}
scenic_hud={"deadzone": 0.2, "events": [Object(InputEventKey,"physical_keycode":72)]}
sector_map={"deadzone": 0.2, "events": [Object(InputEventKey,"physical_keycode":77)]}

surface_extract={"deadzone": 0.2, "events": [Object(InputEventKey,"physical_keycode":69)]}

surface_capture={"deadzone": 0.2, "events": [Object(InputEventKey,"physical_keycode":67)]}
surface_gather={"deadzone": 0.2, "events": [Object(InputEventKey,"physical_keycode":70)]}

surface_land={"deadzone": 0.2, "events": [Object(InputEventKey,"physical_keycode":76)]}
surface_next_bot={"deadzone": 0.2, "events": [Object(InputEventKey,"physical_keycode":66)]}
surface_next_hunt={"deadzone": 0.2, "events": [Object(InputEventKey,"physical_keycode":84)]}

[threading]
worker_pool/max_threads=4
