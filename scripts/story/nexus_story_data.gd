class_name NexusStoryData
extends RefCounted
## Authored text and encounter data, separate from progression and combat.
const CHARACTERS={
 "astra":{"name":"Commander Astra","role":"Vanguard operations","color":Color(.35,.8,1),"bio":"Astra approved the first expedition through the gateway. She counted one returning ship as a success until she heard the names of the missing crew in its engine noise. She wants the frontier safe, even if that means admitting what her orders cost."},
 "sera":{"name":"Archivist Sera","role":"Nexus reconstruction","color":Color(.78,.63,1),"bio":"Sera's brother Ilyan navigated the survey vessel Mnemosyne. The Dominion declared everyone aboard lost. Sera kept his last message: a complaint that the ship's clock was eleven minutes slow. The new distress signal is eleven minutes ahead."},
 "milo":{"name":"Engineer Milo","role":"Fleet systems and recovery","color":Color(1,.72,.4),"bio":"Milo survived the evacuation of a Dominion shipyard by welding a mining tug's reactor to a lifeboat. He names engines after places he cannot return to. He distrusts miraculous technology, but never the people who have to repair it."},
 "veyr":{"name":"Marshal Rhaz Veyr","role":"Crimson interdiction command","color":Color(1,.3,.3),"bio":"Veyr believes an empire is a promise that tomorrow will resemble today. Ny'Zaroth makes that promise impossible. He would burn every relay on the frontier to keep the Dominion's certainty intact."},
 "choir":{"name":"The Unnumbered Choir","role":"Origin unresolved","color":Color(.4,1,.78),"bio":"Many voices share the returned vessel's carrier wave. Some use names from Mnemosyne's missing roster. Others describe stars that have not formed. Sera refuses to label the transmission either a rescue or a weapon without evidence."}}
const MISSIONS={
 "nexus_blockade":{"title":"01 / Lanterns over Varkhoss","location":"Varkhoss Prime · evacuation relay","seed":14621,"tint":Color(.55,.055,.08),"size":3,"object":"Civilian relay","brief":"Crimson Interdictors are erasing an evacuation relay. Defeat their three ships, then approach the gold relay within 95m and hold G for three seconds to transmit the civilian routes. Nearby Interdictors drain relay integrity through jamming. Losing the relay or your fleet fails the sortie.","bonus":"Optional: finish with relay integrity at 70% or more. Earn the Lantern Keeper commendation and 25 salvage once."},
 "nexus_abyss":{"title":"02 / The ship that came home","location":"Ny'Zaroth · the Dreaming Abyss","seed":77939,"tint":Color(.22,.065,.42),"size":3,"object":"Returned vessel / Mnemosyne","brief":"The missing Mnemosyne has returned as a living vessel. Its three wardens are firing on approaching ships. Defeat them, then hold G for four seconds within 95m of the wreck to decode its memory. A pulsing anomaly surrounds the wreck: leave the marked 110m field during its four-second warning.","bonus":"The decoded recording unlocks Sera's account of the lost expedition. Completion grants the Dreaming Abyss hull."},
 "nexus_warfront":{"title":"03 / A door, not a weapon","location":"Nexus relay · contested fracture","seed":81931,"tint":Color(.18,.23,.37),"size":10,"object":"Fracture core","brief":"Veyr has drawn a mixed fleet into the breach. Defeat all ten enemy ships and complete your chosen protocol. SEAL: approach each of three conduits within 95m and hold G for two seconds. PRESERVE: escort the archive core to its jump beacon, staying within 150m; enemies inside 110m stall it and damage its shell.","bonus":"Launching locks your protocol for this chapter. Both routes grant the same chapter reward; the objective, transmissions and ending differ."}}
const CODEX={
 "relay":{"title":"The Lantern Network","unlock":0,"body":"The frontier's evacuation routes are kept on local relays. A route is more than a coordinate: it includes a ship's fuel tolerance, the names of passengers and the station expecting them. Erasing a relay does not destroy a world. It makes the people fleeing it disappear from every rescue manifest. The Nexus Archives began as a promise to remember those names."},
 "dominion":{"title":"Varkhoss Prime / Blood and certainty","unlock":2,"body":"Volcanic mountains, crimson oceans and military shipyards cover the Dominion's homeworld. Its Bloodforged fleets prize armor and overwhelming firepower. Marshal Rhaz Veyr calls conquest a duty: uncertainty ends, he says, when one command speaks for every world. The war against Ny'Zaroth is revealing how little that command understands."},
 "mnemosyne":{"title":"Mnemosyne / Eleven minutes","unlock":5,"body":"The first Dominion expedition returned one ship with an armored hull transformed into living tissue. Mnemosyne's recovered navigation log still contains Ilyan's course corrections. The last correction is dated eleven minutes after the ship's recorded destruction. Sera recognizes his habit of marking safe passages with a small hand-drawn lantern. The Choir has continued drawing them."},
 "nyzaroth":{"title":"Ny'Zaroth / The Dreaming Abyss","unlock":5,"body":"Ny'Zaroth is suspended within a cosmic void. Its floating islands and breathing forests belong to a realm whose laws do not stay still. Some ships are grown rather than built; their pilots steer by thought. The Choir describes memory as a place that can be entered. That may explain Mnemosyne. It does not prove that everything inside the breach wishes humanity well."},
 "protocol":{"title":"The Fracture Protocol","unlock":6,"body":"SEAL burns the three phase conduits, closing the local passage and leaving whatever remains of Mnemosyne beyond reach. PRESERVE evacuates a bounded memory core before the relay closes its military channel. It saves evidence and possible voices, but binds the Vanguard to watch an artifact it cannot fully explain. Neither route ends the Crimson–Eldritch War."}}
# Stable IDs allow the journal to reconstruct only transmissions actually heard.
const RADIO={
 "b_start":["astra","Those lights are evacuation manifests. Veyr is deleting the stations that know where the refugees are going. Break his blockade."],
 "b_veyr":["veyr","Independent fleet, stand down. What waits beyond that relay wears the voices of our dead. I will not give it a road home."],
 "b_milo":["milo","Jamming is eating the relay buffer. Pull the Interdictors away or finish them quickly. The routes cannot survive a full purge."],
 "b_clear":["astra","The blockade is broken. Get close to the gold relay and hold G. We still have to send those people somewhere safe."],
 "b_done":["milo","Routes sent. I found an engine schematic in their command link. Its serial number belongs to Mnemosyne. That ship was lost years ago."],
 "a_start":["sera","Mnemosyne. That is her name, beneath the interference. My brother navigated this ship. Please keep your recorder running."],
 "a_choir":["choir","We kept the lanterns. We kept the names. Why do your ships arrive speaking fire?"],
 "a_warning":["milo","The field is about to discharge. Leave the glowing ring. Your shields can take a mistake, not a habit."],
 "a_clear":["sera","The wardens are quiet. Approach the returned vessel and hold G. I need to know whether this is a memory or someone still alive."],
 "a_done":["choir","Ilyan marked this passage safe. He asked us to keep the way open until his sister could see the stars on the other side."],
 "a_astra":["astra","I signed the order that sent them through. Sera, I should have told you. I thought the truth would cost us this mission."],
 "w_start":["astra","This is the relay we saved. Ten enemy ships are crossing its fracture. Hold your formation; the protocol is yours to carry out."],
 "w_veyr":["veyr","You call uncertainty a choice. I call it a weapon pointed at every home we have left. That core does not leave this sector."],
 "w_seal":["sera","Three conduits. Sever each handshake with G, then finish the enemy fleet. I will not pretend this costs nothing. I will help you close it."],
 "w_preserve":["milo","Core cradle is moving. Stay within 150 metres to guide it. Clear ships inside 110 metres; their interference stalls and cracks the shell."],
 "w_clear":["astra","Enemy weapons are silent. Finish the protocol. Winning the battle does not decide what we carry home."],
 "w_done_seal":["choir","Then keep the lantern outside. If memory has another shore, let it know that someone waited."],
 "w_done_preserve":["sera","Core secured. No weapons link, no open gate. Just voices, and a promise that we will listen carefully."],
 "w_low":["milo","Core integrity is critical. Bring your fleet close and clear the jammers. We cannot weld a memory back together."],
 "retry":["astra","We saved the approach telemetry. Re-form the fleet and try again. A failed sortie does not erase the people we are trying to reach."]}
static func character(id: String) -> Dictionary:
 return CHARACTERS.get(id,CHARACTERS.astra)
static func ending(choice: String) -> String:
 if choice=="seal":return "THE LANTERN OUTSIDE / The breach closes. Evacuation beacons shine across a frontier that will have a tomorrow. Sera places Ilyan's lantern mark on the sealed relay, not as a verdict on what spoke to her, but as a promise to remember. Astra publishes the expedition order with her own signature intact. Far beyond the barrier, one light answers once."
 if choice=="preserve":return "A WITNESS BROUGHT HOME / The core reaches its beacon. Milo disconnects every weapon channel before letting it aboard the archive tender. Sera hears a familiar voice ask whether the ship's clock is still slow. Astra opens the expedition files to the frontier councils. They have brought home evidence, possible survivors, and a responsibility that victory cannot settle."
 return "THE RELAY REMEMBERS / Your earlier commission remains archived. Replay the sorties to hear the reconstructed recordings and choose a protocol for the final encounter. The original chapter reward is already claimed."
